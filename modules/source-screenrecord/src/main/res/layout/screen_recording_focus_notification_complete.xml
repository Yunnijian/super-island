<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_recording_focus_notification_complete_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/screen_recording_focus_notification_complete_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E6000000"
        android:textFontWeight="500"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/screen_recording_focus_notification_complete_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8A000000"
        android:textFontWeight="400"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/screen_recording_focus_notification_complete_share"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/screen_recording_focus_notification_action_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="142dp"
        android:minWidth="52dp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:text="@string/screen_recording_notification_share"
        android:textColor="#E6000000"
        android:textFontWeight="500"
        android:textSize="14sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!--
          In-module capture: same task as MainActivity (no singleInstance / no separate affinity).
          PROJECT_MEDIA auto-grant was still flashing the status bar because the previous
          singleInstance + taskAffinity forced a full task switch on every start.
        -->
        <activity
            android:name=".ScreenRecordingCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          QS tile capture: isolated task so startActivityAndCollapse does not raise MainActivity.
          Do NOT set finishOnCloseSystemDialogs (QS collapse can kill consent mid-flight).
        -->
        <activity
            android:name=".ScreenRecordingTileCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity="io.github.superisland.screenrecord.capture"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ScreenRecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <service
            android:name=".ScreenRecordingTileService"
            android:exported="true"
            android:icon="@drawable/ic_screen_recording"
            android:label="@string/screen_recording_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!--
          In-module capture stays in MainActivity's task. Both capture entries use the same
          transparent, edge-to-edge window so a consent handoff never paints a default black bar.
        -->
        <activity
            android:name=".ScreenRecordingCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.SuperIsland.ScreenRecording.Capture" />

        <!--
          QS launches a no-affinity one-shot task. Do not use singleInstance: on warsaw it creates
          a separate SystemUI bar container and briefly paints the status bar black. The empty
          affinity keeps MainActivity out of this task, so finishing still returns to the caller.
          Do NOT set finishOnCloseSystemDialogs (QS collapse can kill consent mid-flight).
        -->
        <activity
            android:name=".ScreenRecordingTileCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SuperIsland.ScreenRecording.Capture" />

        <service
            android:name=".ScreenRecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <service
            android:name=".ScreenRecordingTileService"
            android:exported="true"
            android:icon="@drawable/ic_screen_recording"
            android:label="@string/screen_recording_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
